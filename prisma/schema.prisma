generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Pattern {
  id       Int       @id @default(autoincrement())
  name     String    @db.VarChar
  teachers Teacher[]

  @@map("pattern")
}

model Teacher {
  id              Int               @id @default(autoincrement())
  firstName       String            @map("first_name") @db.VarChar
  lastName        String            @map("last_name") @db.VarChar
  patronymic      String            @db.VarChar
  color           String            @db.VarChar
  patternColor    String            @map("pattern_color") @db.VarChar
  patternId       Int               @map("pattern_id")
  classes         Class[]
  lessons         Lesson[]
  pattern         Pattern           @relation(fields: [patternId], references: [id], onUpdate: NoAction, map: "FK_teacher_pattern")
  teacherSubjects TeacherSubjects[]

  @@map("teacher")
}

model Subject {
  id              Int               @id @default(autoincrement())
  name            String            @db.VarChar
  lessons         Lesson[]
  teacherSubjects TeacherSubjects[]

  @@map("subject")
}

model TeacherSubjects {
  teacherId Int     @map("teacher_id")
  subjectId Int     @map("subject_id")
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK__teacher")
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_subject")

  @@id([teacherId, subjectId])
  @@map("teacher_subjects")
}

model Classroom {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar
  isAllowConflicts Boolean  @default(false) @map("is_allow_conflicts")
  lessons          Lesson[]

  @@map("classroom")
}

model Lesson {
  id             Int            @id @default(autoincrement())
  teacherId      Int            @map("teacher_id")
  subjectId      Int            @map("subject_id")
  classroomId    Int            @map("classroom_id")
  classroom      Classroom      @relation(fields: [classroomId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_lesson_classroom")
  subject        Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_lesson_subject")
  teacher        Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_lesson_teacher")
  scheduleCells1 ScheduleCell[] @relation("Lesson1")
  scheduleCells2 ScheduleCell[] @relation("Lesson2")

  @@map("lesson")
}

model Class {
  id            Int            @id @default(autoincrement())
  name          String         @db.VarChar
  teacherId     Int            @map("teacher_id")
  displayOrder  Int            @map("display_order")
  teacher       Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK__teacher")
  scheduleCells ScheduleCell[]

  @@map("class")
}

model ScheduleCell {
  id         Int     @id(map: "shedule_cell_pkey") @default(autoincrement())
  dayOfWeek  Int     @map("day_of_week")
  orderInDay Int     @map("order_in_day")
  classId    Int     @map("class_id")
  lesson1Id  Int     @map("lesson1_id")
  lesson2Id  Int?    @map("lesson2_id")
  tableType  String  @map("table_type") @db.VarChar
  class      Class   @relation(fields: [classId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_shedule_cell_class")
  lesson1    Lesson  @relation("Lesson1", fields: [lesson1Id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_shedule_cell_lesson")
  lesson2    Lesson? @relation("Lesson2", fields: [lesson2Id], references: [id], onUpdate: NoAction, map: "FK_shedule_cell_lesson_2")

  @@map("schedule_cell")
}

model pgmigrations {
  id     Int      @id @default(autoincrement())
  name   String   @db.VarChar(255)
  run_on DateTime @db.Timestamp(6)
}
